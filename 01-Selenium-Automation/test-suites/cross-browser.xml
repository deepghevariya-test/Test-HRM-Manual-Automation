<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  CROSS-BROWSER TEST SUITE
  Runs smoke tests across Chrome, Firefox, and Edge.
  Use -Dbrowser=firefox or -Dbrowser=edge to target specific browser.
  
  Usage: 
    mvn test -Dsuite=cross-browser -Dbrowser=chrome
    mvn test -Dsuite=cross-browser -Dbrowser=firefox
    mvn test -Dsuite=cross-browser -Dbrowser=edge
-->
<suite name="HRM_CrossBrowser_Suite" verbose="1" thread-count="3" parallel="tests">

    <listeners>
        <listener class-name="com.hrm.listeners.TestNGListener"/>
    </listeners>

    <!-- Chrome Tests -->
    <test name="Chrome_Regression">
        <parameter name="browser" value="chrome"/>
        <parameter name="headless" value="true"/>
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.hrm.tests.LoginTests"/>
            <class name="com.hrm.tests.EmployeeCRUDTests"/>
        </classes>
    </test>

    <!-- Firefox Tests -->
    <test name="Firefox_Regression">
        <parameter name="browser" value="firefox"/>
        <parameter name="headless" value="true"/>
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.hrm.tests.LoginTests"/>
            <class name="com.hrm.tests.EmployeeCRUDTests"/>
        </classes>
    </test>

    <!-- Edge Tests -->
    <test name="Edge_Regression">
        <parameter name="browser" value="edge"/>
        <parameter name="headless" value="true"/>
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.hrm.tests.LoginTests"/>
            <class name="com.hrm.tests.EmployeeCRUDTests"/>
        </classes>
    </test>

</suite>
